<UserControl x:Class="Yell.Modules.Monitor.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:scott="clr-namespace:ScottPlot;assembly=ScottPlot.WPF"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="720"
             Foreground="{DynamicResource Brush.TextPrimary}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="1.4*" />
        </Grid.RowDefinitions>

        <!-- KPI 指标卡 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource Style.Card}" Padding="16,14" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="样本总数" Style="{DynamicResource Style.Text.Caption}" />
                    <TextBlock Text="{Binding SampleCountText}" Style="{DynamicResource Style.KpiValue}" />
                    <Border Width="24" Height="3" CornerRadius="2" HorizontalAlignment="Left"
                            Background="{DynamicResource Brush.Accent}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{DynamicResource Style.Card}" Padding="16,14" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="当前值" Style="{DynamicResource Style.Text.Caption}" />
                    <TextBlock Text="{Binding CurrentValueText}" Style="{DynamicResource Style.KpiValue}" />
                    <Border Width="24" Height="3" CornerRadius="2" HorizontalAlignment="Left"
                            Background="{DynamicResource Brush.Success}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{DynamicResource Style.Card}" Padding="16,14" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="最小值" Style="{DynamicResource Style.Text.Caption}" />
                    <TextBlock Text="{Binding MinValueText}" Style="{DynamicResource Style.KpiValue}" />
                    <Border Width="24" Height="3" CornerRadius="2" HorizontalAlignment="Left"
                            Background="{DynamicResource Brush.Tx}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{DynamicResource Style.Card}" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="最大值" Style="{DynamicResource Style.Text.Caption}" />
                    <TextBlock Text="{Binding MaxValueText}" Style="{DynamicResource Style.KpiValue}" />
                    <Border Width="24" Height="3" CornerRadius="2" HorizontalAlignment="Left"
                            Background="{DynamicResource Brush.Rx}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 实时波形 -->
        <Border Grid.Row="1" Style="{DynamicResource Style.Card}" Padding="0" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="18,14,18,2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="实时采样波形" Style="{DynamicResource Style.SectionTitle}" />
                        <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="10"
                                Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ScottPlot" FontSize="10"
                                       Foreground="{DynamicResource Brush.Accent}" />
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource Brush.TextSecondary}" />
                </Grid>

                <scott:WpfPlot x:Name="RealTimePlot"
                               Grid.Row="1"
                               Margin="8,2,8,8"
                               Background="Transparent" />
            </Grid>
        </Border>

        <!-- 报文监控台 -->
        <Border Grid.Row="2" Style="{DynamicResource Style.Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 工具栏 -->
                <Grid Grid.Row="0" Margin="18,12,18,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="报文监控" Style="{DynamicResource Style.SectionTitle}" />
                        <TextBlock Text="HEX · 实时刷新" Margin="10,0,0,0"
                                   VerticalAlignment="Center" FontSize="10"
                                   Foreground="{DynamicResource Brush.TextMuted}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <CheckBox x:Name="AutoScrollCheckBox"
                                  Content="自动滚动"
                                  IsChecked="True"
                                  Margin="0,0,14,0"
                                  VerticalAlignment="Center" />
                        <Button Content="导出 CSV"
                                Command="{Binding ExportCommand}"
                                Style="{DynamicResource Style.Button.Secondary}"
                                Height="30" Padding="12,0" />
                        <Button Content="清空"
                                Command="{Binding ClearCommand}"
                                Style="{DynamicResource Style.Button.Ghost}"
                                Height="30" Padding="12,0" Margin="6,0,0,0" />
                    </StackPanel>
                </Grid>

                <!-- 列标题 -->
                <Border Grid.Row="1" Background="{DynamicResource Brush.HeaderBackground}"
                        BorderBrush="{DynamicResource Brush.Divider}"
                        BorderThickness="0,1,0,1" Padding="18,7,30,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="时间" Style="{DynamicResource Style.Text.ColumnHeader}" />
                        <TextBlock Grid.Column="1" Text="方向" Style="{DynamicResource Style.Text.ColumnHeader}" />
                        <TextBlock Grid.Column="2" Text="原始 HEX 报文" Style="{DynamicResource Style.Text.ColumnHeader}" />
                        <TextBlock Grid.Column="3" Text="测量值" Style="{DynamicResource Style.Text.ColumnHeader}" />
                    </Grid>
                </Border>

                <!-- 日志列表 -->
                <Grid Grid.Row="2">
                    <ListBox x:Name="LogListBox"
                             ItemsSource="{Binding Logs}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="76" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Time}"
                                               FontSize="11"
                                               Foreground="{DynamicResource Brush.TextMuted}" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Direction}"
                                               FontSize="11"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Direction}" Value="TX">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Tx}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Direction}" Value="RX">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Rx}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Direction}" Value="系统">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Direction}" Value="错误">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding RawData}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Brush.TextPrimary}" />

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Value}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Accent}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Logs.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="暂无报文"
                                   HorizontalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBlock Text="连接串口，或在左侧点击「生成模拟波形」"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource Brush.TextMuted}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
