<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色主题色板。所有键名与 Colors.Dark.xaml 保持一致 -->
    <SolidColorBrush x:Key="Brush.WindowBackground" Color="#F3F6FB" />
    <SolidColorBrush x:Key="Brush.SidebarBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.CardBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#E2E8F0" />

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#0F172A" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#475569" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#94A3B8" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#0284C7" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#E0F2FE" />
    <SolidColorBrush x:Key="Brush.AccentForeground" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Brush.Success" Color="#059669" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#D1FAE5" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#DC2626" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#FEE2E2" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#D97706" />

    <SolidColorBrush x:Key="Brush.InputBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.InputBorder" Color="#CBD5E1" />
    <SolidColorBrush x:Key="Brush.HoverBackground" Color="#F1F5F9" />
    <SolidColorBrush x:Key="Brush.SelectedBackground" Color="#E0F2FE" />

    <SolidColorBrush x:Key="Brush.Tx" Color="#2563EB" />
    <SolidColorBrush x:Key="Brush.Rx" Color="#059669" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#E2E8F0" />
    <SolidColorBrush x:Key="Brush.HeaderBackground" Color="#F8FAFC" />

</ResourceDictionary>
