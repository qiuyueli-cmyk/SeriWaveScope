<Window x:Class="Yell.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:core="clr-namespace:Yell.Core.Constants;assembly=Yell.Core"
        mc:Ignorable="d"
        Title="SeriWaveScope · 串口波形监控平台"
        Height="820" Width="1320"
        MinHeight="680" MinWidth="1080"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="Segoe UI, Microsoft YaHei"
        FontSize="12"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= 左侧导航 + 硬件面板 ================= -->
        <Border Grid.Column="0"
                Background="{DynamicResource Brush.SidebarBackground}"
                BorderBrush="{DynamicResource Brush.Divider}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 品牌 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="22,24,22,18">
                    <Border Width="40" Height="40" CornerRadius="11"
                            Background="{DynamicResource Brush.Accent}">
                        <Path Width="24" Height="18"
                              Stretch="Fill"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M 0 9 L 5 9 L 8 2 L 12 16 L 16 6 L 19 9 L 24 9"
                              Stroke="{DynamicResource Brush.AccentForeground}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SeriWaveScope"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                        <TextBlock Text="串口波形监控平台"
                                   FontSize="10"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource Brush.TextMuted}" />
                    </StackPanel>
                </StackPanel>

                <!-- 导航 -->
                <StackPanel Grid.Row="1" Margin="14,0,14,12">
                    <TextBlock Text="工作区"
                               Margin="10,0,0,6"
                               FontSize="9.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextMuted}" />

                    <Button Content="实时监控"
                            Tag="{Binding IsMonitorActive}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static core:ViewNames.Monitor}"
                            Style="{DynamicResource Style.Nav}" />

                    <Button Content="历史数据"
                            Tag="{Binding IsHistoryActive}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static core:ViewNames.History}"
                            Style="{DynamicResource Style.Nav}"
                            Margin="0,4,0,0" />
                </StackPanel>

                <!-- 采集模块注入的硬件面板 -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="14,2,14,14">
                    <ContentControl prism:RegionManager.RegionName="{x:Static core:RegionNames.HardwareRegion}" />
                </ScrollViewer>

                <!-- 版本信息 -->
                <Border Grid.Row="3"
                        BorderBrush="{DynamicResource Brush.Divider}"
                        BorderThickness="0,1,0,0"
                        Padding="22,12">
                    <Grid>
                        <TextBlock Text="Prism 9 · WPF · SQLite"
                                   FontSize="10"
                                   Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock Text="v2.0"
                                   HorizontalAlignment="Right"
                                   FontSize="10"
                                   Foreground="{DynamicResource Brush.TextMuted}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ================= 右侧主区域 ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 页头 -->
            <Grid Grid.Row="0" Margin="24,20,24,10">
                <StackPanel Orientation="Horizontal">
                    <Border Width="3" Height="32" CornerRadius="2"
                            Background="{DynamicResource Brush.Accent}"
                            Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentTitle}"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                        <TextBlock Text="{Binding CurrentSubtitle}"
                                   Margin="0,3,0,0"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource Brush.TextMuted}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- 连接状态 -->
                    <Border Padding="11,6" CornerRadius="14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionText}"
                                       Margin="6,0,0,0"
                                       FontSize="11"
                                       FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Button Content="{Binding ThemeButtonText}"
                            Command="{Binding ToggleThemeCommand}"
                            Style="{DynamicResource Style.Button.Secondary}"
                            Height="32"
                            Padding="14,0"
                            Margin="10,0,0,0" />
                </StackPanel>
            </Grid>

            <!-- 导航区域：MonitorView / HistoryView -->
            <ContentControl Grid.Row="1"
                            prism:RegionManager.RegionName="{x:Static core:RegionNames.MainRegion}"
                            Margin="24,4,24,20" />
        </Grid>
    </Grid>
</Window>
