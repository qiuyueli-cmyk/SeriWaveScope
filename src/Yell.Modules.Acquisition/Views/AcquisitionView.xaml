<UserControl x:Class="Yell.Modules.Acquisition.Views.AcquisitionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="260"
             d:DesignHeight="620"
             Foreground="{DynamicResource Brush.TextPrimary}">

    <Border Style="{DynamicResource Style.Card}" Padding="14">
        <StackPanel>

            <!-- 标题 + 连接状态 -->
            <Grid Margin="0,0,0,12">
                <TextBlock Text="设备连接"
                           Style="{DynamicResource Style.SectionTitle}" />
                <Border HorizontalAlignment="Right"
                        Padding="8,3"
                        CornerRadius="10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionStateText}"
                                   Margin="5,0,0,0"
                                   FontSize="10"
                                   FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 串口选择 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding Ports}"
                          SelectedItem="{Binding SelectedPort}"
                          DisplayMemberPath="DisplayName"
                          ToolTip="{Binding SelectedPort.Description}" />

                <Button Grid.Column="2"
                        Content="刷新"
                        Command="{Binding RefreshPortsCommand}"
                        Style="{DynamicResource Style.Button.Secondary}"
                        Height="34"
                        Padding="10,0" />
            </Grid>

            <CheckBox Content="显示蓝牙虚拟串口"
                      IsChecked="{Binding ShowBluetoothPorts}"
                      Margin="0,8,0,0"
                      FontSize="11"
                      Foreground="{DynamicResource Brush.TextSecondary}" />

            <TextBlock Text="{Binding PortHint}"
                       Margin="0,5,0,0"
                       FontSize="10"
                       LineHeight="15"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextMuted}" />

            <!-- 通讯参数 -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="波特率"
                           Style="{DynamicResource Style.Text.Caption}" />
                <ComboBox Grid.Row="1" Grid.Column="0"
                          ItemsSource="{Binding BaudRateList}"
                          SelectedItem="{Binding SelectedBaudRate}" />

                <TextBlock Grid.Row="0" Grid.Column="2" Text="数据位"
                           Style="{DynamicResource Style.Text.Caption}" />
                <ComboBox Grid.Row="1" Grid.Column="2"
                          ItemsSource="{Binding DataBitsList}"
                          SelectedItem="{Binding SelectedDataBits}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="校验位"
                           Margin="0,8,0,0"
                           Style="{DynamicResource Style.Text.Caption}" />
                <ComboBox Grid.Row="3" Grid.Column="0"
                          ItemsSource="{Binding ParityOptions.Keys}"
                          SelectedItem="{Binding SelectedParityKey}" />

                <TextBlock Grid.Row="2" Grid.Column="2" Text="停止位"
                           Margin="0,8,0,0"
                           Style="{DynamicResource Style.Text.Caption}" />
                <ComboBox Grid.Row="3" Grid.Column="2"
                          ItemsSource="{Binding StopBitsOptions.Keys}"
                          SelectedItem="{Binding SelectedStopBitsKey}" />
            </Grid>

            <Button Content="{Binding ConnectButtonText}"
                    Command="{Binding ToggleConnectionCommand}"
                    Style="{DynamicResource Style.Button.Primary}"
                    Margin="0,12,0,0" />

            <Button Content="{Binding SimulateButtonText}"
                    Command="{Binding SimulateCommand}"
                    Style="{DynamicResource Style.Button.Secondary}"
                    Margin="0,8,0,0" />

            <Border Height="1"
                    Background="{DynamicResource Brush.Divider}"
                    Margin="0,14,0,12" />

            <!-- 指令下发 -->
            <TextBlock Text="指令下发（HEX 负载）"
                       Style="{DynamicResource Style.Text.Caption}" />

            <TextBox Text="{Binding InputHexText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource Style.TextBox}"
                     Height="56"
                     Margin="0,6,0,0"
                     Padding="8,6"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" />

            <Button Content="封装并发送"
                    Command="{Binding SendCommand}"
                    Style="{DynamicResource Style.Button.Primary}"
                    Margin="0,8,0,0" />

            <TextBlock Text="自动封装：AA + 负载长度 + 负载"
                       Margin="0,5,0,0"
                       FontSize="10"
                       Foreground="{DynamicResource Brush.TextMuted}" />

            <!-- 当前连接详情 -->
            <Border Background="{DynamicResource Brush.HoverBackground}"
                    CornerRadius="6"
                    Padding="8,6"
                    Margin="0,12,0,0">
                <TextBlock Text="{Binding ConnectionDetail}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
            </Border>

        </StackPanel>
    </Border>
</UserControl>
